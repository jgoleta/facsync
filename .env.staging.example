# Copy to .env.staging. Use a Supabase project different from production.
# Initially copy admin credentials from Connect > Direct or Session pooler.
# scripts/setup_staging_schema.py --apply provisions an isolated schema/login
# and replaces the user/password below with that restricted login.
STAGING_DB_NAME=postgres
STAGING_DB_USER=
STAGING_DB_PASSWORD=
STAGING_DB_HOST=
STAGING_DB_PORT=5432
STAGING_DB_SCHEMA=facsync_staging
