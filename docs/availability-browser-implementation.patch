+<div id="analytics-browser" data-endpoint="{% url 'students:availability_browser_api' %}" data-label="Faculty availability" data-source-label="View faculty directory">
+    <button type="button" id="analytics-chat-toggle" aria-label="Open faculty availability" aria-expanded="false" aria-controls="analytics-chat-panel" hidden>Faculty availability</button>
+    <section id="analytics-chat-panel" role="dialog" aria-labelledby="analytics-chat-title" hidden>
+        <header class="analytics-chat-header">
+            <div><h2 id="analytics-chat-title">Faculty availability</h2><p>{{ request.user.college_name|default:request.user.college }} &middot; Your college only</p></div>
+            <button type="button" id="analytics-chat-close" aria-label="Close faculty availability">&times;</button>
