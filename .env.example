# Django and deployment
SITE_URL=http://127.0.0.1:8000

# PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Google OAuth and Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8000/faculty/calendar/callback/
GOOGLE_CALENDAR_TIME_ZONE=Asia/Manila
GOOGLE_CALENDAR_SYNC_PAST_DAYS=1
GOOGLE_CALENDAR_SYNC_FUTURE_DAYS=60

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_INSIGHTS_REFRESH_DAYS=7

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Optional HTTPS transport: apps.core.email_backends.BrevoEmailBackend
BREVO_API_KEY=
BREVO_BATCH_SIZE=100
# Automatic status only: migrate and configure cron-job.org before enabling.
AUTOMATIC_STATUS_EMAIL_QUEUE_ENABLED=False
STATUS_SCHEDULER_SECRET=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Profile uploads 
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_FACULTY_PHOTO_BUCKET=faculty-photos
SUPABASE_STUDENT_PHOTO_BUCKET=student-photos
