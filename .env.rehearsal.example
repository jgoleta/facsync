# Copy to .env.rehearsal and use ONLY the NEW production-copy rehearsal project.
# Never put production or existing staging connection details here.
# This is a connection template, not authorization to run migrations.
# Its restored FacSync tables are in public, not facsync_staging.
REHEARSAL_DB_NAME=postgres
REHEARSAL_DB_USER=
REHEARSAL_DB_PASSWORD=
REHEARSAL_DB_HOST=
REHEARSAL_DB_PORT=5432
REHEARSAL_DB_SCHEMA=public
