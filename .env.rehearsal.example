# A disposable Supabase project, separate from production. Never commit the filled .env.rehearsal.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
# The URL and server secret key must be from this same rehearsal project.
# Leaving these empty disables uploads instead of falling back to production storage.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SCHOOL_EVIDENCE_BUCKET=school-verification
SCHOOL_EVIDENCE_CLEANUP_SECRET=
